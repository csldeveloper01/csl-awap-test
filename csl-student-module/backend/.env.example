# Django Core
DJANGO_SECRET_KEY=replace-with-strong-production-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DB_ENGINE=postgres
DATABASE_URL=postgres://user:password@host:5432/csl_assessment

# Redis Caching & Celery Background Workers
# Leave empty locally for automatic LocMemCache + synchronous task fallback
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3
CELERY_TASK_ALWAYS_EAGER=False

# CORS / Frontend
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://127.0.0.1:5173
FRONTEND_URL=https://your-app.vercel.app
